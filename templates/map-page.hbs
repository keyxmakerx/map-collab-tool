<div class="mct-map-container">
  {{!-- Toolbar --}}
  <div class="mct-toolbar">
    <div class="mct-toolbar-group">
      <label>{{localize "MCT.MapPage.PinType"}}:</label>
      <select class="mct-pin-type-select">
        {{#each pinTypes}}
        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="mct-toolbar-group">
      <button type="button" class="mct-draw-toggle {{#if isDrawing}}active{{/if}}" title="{{localize "MCT.MapPage.DrawToggle"}}">
        <i class="fa-solid fa-pencil"></i>
      </button>
      <input type="color" class="mct-draw-color" value="{{drawColor}}" title="{{localize "MCT.MapPage.DrawColor"}}" />
    </div>

    <div class="mct-toolbar-group">
      <button type="button" class="mct-zoom-in" title="{{localize "MCT.MapPage.ZoomIn"}}" aria-label="{{localize "MCT.MapPage.ZoomIn"}}">
        <i class="fa-solid fa-magnifying-glass-plus"></i>
      </button>
      <button type="button" class="mct-zoom-out" title="{{localize "MCT.MapPage.ZoomOut"}}" aria-label="{{localize "MCT.MapPage.ZoomOut"}}">
        <i class="fa-solid fa-magnifying-glass-minus"></i>
      </button>
      <button type="button" class="mct-zoom-reset" title="{{localize "MCT.MapPage.ZoomReset"}}" aria-label="{{localize "MCT.MapPage.ZoomReset"}}">
        <i class="fa-solid fa-compress"></i>
      </button>
    </div>

    {{#if isGM}}
    <div class="mct-toolbar-group">
      <button type="button" class="mct-set-image" title="{{localize "MCT.MapPage.SetImage"}}">
        <i class="fa-solid fa-image"></i> {{localize "MCT.MapPage.SetImage"}}
      </button>
    </div>
    <div class="mct-toolbar-group">
      <button type="button" class="mct-permissions-toggle {{#if anyoneCanEdit}}active{{/if}}" title="{{localize "MCT.MapPage.PermissionsToggle"}}">
        <i class="fa-solid fa-lock-open"></i> {{localize "MCT.MapPage.PermissionsToggle"}}
      </button>
    </div>
    <div class="mct-toolbar-group">
      <button type="button" class="mct-clear-drawings" title="{{localize "MCT.MapPage.ClearDrawings"}}">
        <i class="fa-solid fa-eraser"></i> {{localize "MCT.MapPage.ClearDrawings"}}
      </button>
    </div>
    {{/if}}
  </div>

  {{!-- Map viewport --}}
  <div class="mct-viewport">
    <div class="mct-map-layer" style="transform: translate({{panX}}px, {{panY}}px) scale({{zoom}});">
      {{#if mapImage}}
      <div class="mct-map-image-wrapper">
        <img class="mct-map-image" src="{{mapImage}}" alt="Map" draggable="false" />

        {{!-- Drawing SVG layer --}}
        <svg class="mct-drawing-layer" viewBox="0 0 100 100" preserveAspectRatio="none">
          {{#each drawings}}
          <polyline data-drawing-id="{{this.id}}"
                    points="{{this.svgPoints}}"
                    stroke="{{this.color}}"
                    stroke-width="{{this.strokeWidth}}"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round" />
          {{/each}}
        </svg>

        {{!-- Pin overlay (sized to the image) --}}
        <div class="mct-pins-layer">
          {{#each pins}}
          {{#if this.isText}}
          <div class="mct-pin mct-pin-text {{#if this.isPrivate}}mct-pin-private{{/if}} {{#if this.hasLink}}mct-pin-linked{{/if}}"
               data-pin-id="{{this.id}}"
               style="left: {{this.x}}%; top: {{this.y}}%; --pin-color: {{this.color}};"
               title="{{this.label}}">
            <span class="mct-text-content">{{this.label}}</span>
          </div>
          {{else}}
          <div class="mct-pin {{#if this.isPrivate}}mct-pin-private{{/if}} {{#if this.hasLink}}mct-pin-linked{{/if}}"
               data-pin-id="{{this.id}}"
               style="left: {{this.x}}%; top: {{this.y}}%; --pin-color: {{this.color}};"
               title="{{this.label}}">
            <i class="fa-solid {{this.icon}}"></i>
            {{#if this.label}}<span class="mct-pin-label">{{this.label}}</span>{{/if}}
          </div>
          {{/if}}
          {{/each}}
        </div>
      </div>
      {{else}}
      <div class="mct-no-image">
        <i class="fa-solid fa-map"></i>
        <p>{{localize "MCT.MapPage.NoImage"}}</p>
        {{#if isGM}}
        <button type="button" class="mct-set-image">
          <i class="fa-solid fa-image"></i> {{localize "MCT.MapPage.SetImage"}}
        </button>
        {{/if}}
      </div>
      {{/if}}
    </div>

    {{!-- Journal popup (added dynamically via JS) --}}
  </div>
</div>
