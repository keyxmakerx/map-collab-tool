{
  "id": "map-collab-tool",
  "title": "Collaborative Map Tool",
  "description": "A system-agnostic interactive map journal page where players can place, move, and manage pins collaboratively in real-time.",
  "version": "0.3.1",
  "authors": [
    {
      "name": "map-collab-tool contributors"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "documentTypes": {
    "JournalEntryPage": {
      "map": {}
    }
  },
  "esmodules": [
    "scripts/module.mjs"
  ],
  "styles": [
    "styles/map-collab-tool.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": true,
  "url": "https://github.com/keyxmakerx/map-collab-tool",
  "manifest": "https://raw.githubusercontent.com/keyxmakerx/map-collab-tool/main/module.json",
